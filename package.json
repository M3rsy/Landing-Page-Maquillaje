{
  "name": "landing-page-maquillaje",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=26.0.0"
  },
  "description": "Landing estatica de JOYERIA JRV con catalogo de maquillaje.",
  "scripts": {
    "start": "node --env-file-if-exists=.env backend/server.js",
    "dev": "node --env-file-if-exists=.env --watch backend/server.js",
    "create-admin": "node --env-file-if-exists=.env backend/scripts/create-admin.js",
    "setup:tailwind": "powershell -ExecutionPolicy Bypass -File scripts/download-tailwind.ps1",
    "build:css": "powershell -ExecutionPolicy Bypass -File scripts/build-css.ps1",
    "watch:css": "powershell -ExecutionPolicy Bypass -File scripts/watch-css.ps1",
    "build:css:npm": "tailwindcss -i ./assets/css/input.css -o ./assets/css/styles.css && tailwindcss -i ./assets/css/input.css -o ./assets/css/styles.min.css --minify",
    "build:js": "terser ./assets/js/script.js --compress --mangle --output ./assets/js/script.min.js",
    "bump:assets": "node scripts/bump-asset-version.mjs",
    "build": "npm run build:css:npm && npm run build:js",
    "check:html": "htmlhint index.html",
    "check:js": "node --check assets/js/script.js && node --check assets/js/script.min.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "htmlhint": "^1.1.4",
    "tailwindcss": "^3.4.17",
    "terser": "^5.31.6"
  }
}
