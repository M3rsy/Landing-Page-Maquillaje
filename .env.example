# ============================================================
# Configuración de entorno — JOYERIA JRV Backend
# ============================================================
# Copia este archivo como .env y completa los valores reales.
# NUNCA commitees el archivo .env al repositorio.
#
# Setup inicial:
#   cp .env.example .env
#   # Edita .env con tus valores
#   ADMIN_PASSWORD=tu_contraseña node backend/scripts/create-admin.js
#   npm start
# ============================================================

# Puerto donde escucha el servidor Express (opcional, default: 3000)
PORT=3000

# Secreto para firmar tokens JWT.
# OBLIGATORIO. Genera uno seguro con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Orígenes permitidos para CORS (separados por coma, sin espacios).
# Déjalo vacío si el frontend y el backend corren en el mismo dominio/puerto.
# Ejemplo para producción con dominio separado: CORS_ORIGIN=https://jrv.example.com
CORS_ORIGIN=

# Contraseña del usuario admin (solo para el script de setup inicial).
# No es necesaria en producción; elimínala del .env tras ejecutar el script.
# ADMIN_PASSWORD=
