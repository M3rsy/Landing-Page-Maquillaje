# ============================================================
# Configuración de entorno — JOYERIA JRV Backend
# ============================================================
# Copia este archivo como .env y completa los valores reales.
# NUNCA commitees el archivo .env al repositorio.
#
# Setup inicial:
#   cp .env.example .env
#   # Edita .env con tus valores (JWT_SECRET obligatorio, ADMIN_PASSWORD para el admin)
#   npm run create-admin
#   npm start
# ============================================================

# Puerto donde escucha el servidor Express (opcional, default: 3000)
PORT=3000

# Secreto para firmar tokens JWT.
# OBLIGATORIO. Genera uno seguro con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Orígenes permitidos para CORS (separados por coma, sin espacios).
# Déjalo vacío si el frontend y el backend corren en el mismo dominio/puerto.
# Ejemplo para producción con dominio separado: CORS_ORIGIN=https://jrv.example.com
CORS_ORIGIN=

# Contraseña del usuario admin (solo para el script de setup inicial).
# No es necesaria en producción; elimínala del .env tras ejecutar el script.
# ADMIN_PASSWORD=

# Paths para almacenamiento persistente (recomendado en Docker/Dokploy con volumen).
# En Docker: usar junto a -v /data/jrv:/app/backend/data
# DB_PATH=/app/backend/data/jrv.db
# UPLOADS_DIR=/app/backend/data/uploads
# DB_PATH=
# UPLOADS_DIR=

# Entorno de ejecución (development | production).
# Afecta el flag `secure` de la cookie de autenticación cuando AUTH_COOKIE_SECURE no está definido.
NODE_ENV=production

# Duración del token JWT en horas (opcional, default: 8).
AUTH_TOKEN_TTL_HOURS=8

# Política SameSite de la cookie de autenticación (lax | strict | none, default: lax).
AUTH_COOKIE_SAMESITE=lax

# Forzar o desactivar el flag Secure en la cookie (true | false).
# Si no se define, se infiere desde NODE_ENV y AUTH_COOKIE_SAMESITE.
AUTH_COOKIE_SECURE=

# Dominio de la cookie de autenticación (opcional).
# Útil para subdominios compartidos. Ejemplo: .jrv.example.com
AUTH_COOKIE_DOMAIN=
